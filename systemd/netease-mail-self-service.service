[Unit]
Description=Independent Feishu NetEase enterprise mail self-service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netease-mail
Group=netease-mail
WorkingDirectory=/opt/netease-mail-self-service
EnvironmentFile=/opt/netease-mail-self-service/config.env
ExecStart=/usr/bin/python3 /opt/netease-mail-self-service/app.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/netease-mail-self-service/data /opt/netease-mail-self-service/logs
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
