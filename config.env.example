# Copy to /opt/netease-mail-self-service/config.env and fill in real values.
# This file contains no production credentials. Every value below is a
# placeholder; the service refuses to start or stays unconfigured until the
# required ones are set.

# Where the process listens. Put a TLS-terminating reverse proxy in front.
BIND_HOST=127.0.0.1
BIND_PORT=8500
# Public origin as seen by the browser and registered with Feishu.
PUBLIC_BASE_URL=https://mail.example.com
BASE_PATH=
TRUST_PROXY=1
COOKIE_SECURE=1
# None lets the page run inside the Feishu workbench iframe; Lax is stricter.
COOKIE_SAMESITE=None
SESSION_TTL=900
SESSION_COOKIE=netease_mail_session
# Generate with: openssl rand -hex 32  (hex only; systemd EnvironmentFile
# mangles quotes, backslashes and '#').
SESSION_SECRET=replace-with-at-least-24-random-bytes
HTTP_TIMEOUT=20
LOG_LEVEL=INFO
DATA_DIR=/opt/netease-mail-self-service/data
LOG_DIR=/opt/netease-mail-self-service/logs

# A dedicated Feishu custom app for this service: web app + bot enabled,
# callback ${PUBLIC_BASE_URL}/auth/feishu/callback whitelisted, contact
# (employee id, email, mobile, department) and message-sending scopes granted,
# and a version published.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=

# NetEase Enterprise Mail open platform (自建应用) credentials.
NETEASE_APP_ID=replace-me
NETEASE_AUTH_CODE=replace-me
NETEASE_ORG_OPEN_ID=replace-me
# Mailboxes are created only under this domain, using the Feishu work email
# local part as the account name.
NETEASE_DOMAIN=example.com
# Every read and write is pinned below this NetEase unit. The id alone
# addresses the tree; the unit must exist or the service stops.
NETEASE_ROOT_UNIT_ID=100000
# Optional assertion that the id still points at the company you think it does,
# checked on every unit listing. A mismatch stops the service (fail closed), so
# renaming the unit in NetEase means updating this line and restarting.
# Leave it EMPTY to skip the check: renames then cause no outage, and the
# observed name is written to the log instead. Only the id, the work-email
# domain and the per-tenant Feishu app guard the company boundary in that mode.
NETEASE_ROOT_UNIT_NAME=
NETEASE_WEB_LOGIN_URL=https://qiye.163.com/login/

# Start in observation-only mode. Change to 0 only after Feishu OAuth,
# directory access, bot delivery and NetEase queries have all been verified.
READ_ONLY=1
# Seconds a Feishu authentication stays "fresh" enough for a password reset.
# Set to 0 to drop the re-authentication step. The generated password only ever
# reaches the account owner's own Feishu, so a hijacked session cannot steal a
# credential either way; the check only guards against a nuisance reset, and
# rate limiting plus the short SESSION_TTL already bound that.
FRESH_AUTH_TTL=300
# 0-no change required, 1-web login must change it, 2-web login must change it
# and clients cannot log in until it is changed.
NETEASE_PASS_CHANGE_FIRST_LOGIN=2
NETEASE_VISIBLE_IN_ADDR=1
INITIAL_PASSWORD_DIGITS=6
# Feishu department that stands for the company. Only path segments below it
# are mapped onto NetEase units under NETEASE_ROOT_UNIT_ID, which is what keeps
# one company's employees out of another's tree in a multi-company tenant.
# Leave it EMPTY when the Feishu tree has no such node (a tenant organized by
# function, or one holding a single company): the whole path is then mirrored
# below the root unit. Check a real employee's path first -- a wrong value
# rejects every provisioning request.
FEISHU_DEPARTMENT_ANCHOR=
# 1 creates NetEase units missing from the mapped path; 0 refuses instead.
# Recommended 0 for the first rollout until Feishu and NetEase names agree.
CREATE_MISSING_UNITS=0
